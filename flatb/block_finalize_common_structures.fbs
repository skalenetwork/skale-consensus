namespace block_finalize;

table Transaction {
    data: [uint8] (required);  // Each transaction is a byte array
}

// Hashes should be structs for efficient memory layout
struct Hash {
    data: [uint8:32];
}

// Hashes should be structs for efficient memory layout
struct ExtraData {
    data: [uint8:32];
}

struct TruncatedHash {
    data: [uint8:8];
}

table BlockHeader {
    schain_id: uint64;
    epoch_id: uint64;
    block_id: uint64;
    proposer_index: uint64;
    transaction_count: uint64;
    time_stamp_s: uint64;
    time_stamp_ms: uint64;
    transactions_merkle_root : Hash (required);
    parent_hash : Hash (required);
    extra_data: ExtraData  (required);
    committee_hash: [Hash] (required);
    public_key_hash: [Hash] (required);
    encrypted_transaction_indices: [uint16] (required);
}




// Flattened BlockFragment to remove unnecessary nesting
table BlockFragment {
    index: uint16;
    tx_truncated_hashes: [TruncatedHash] (required);  // Already an inline array
    left_proof: [Hash] (required);
    right_proof: [Hash] (required);
}

// DecryptionShare is a struct since it has a fixed format
table DecryptionShare {
    transaction_index: uint16;
    data: [uint8] (required);
}

// ErrorResponse remains a table due to variable-length string
table ErrorResponse {
    status: uint;
    substatus: uint;
    last_block: uint64;
    last_block_timestamp: uint64;
    message: string (required);
}

