namespace block_finalize;

table Transaction {
    data: [ubyte] (required);  // Each transaction is a byte array
}

// Hashes should be structs for efficient memory layout
struct Hash {
    data: [ubyte:32];
}

struct TruncatedHash {
    data: [ubyte:20];
}

struct BlockHeader {
    schain_id: uint64;
    epoch_id: uint64;
    block_id: uint64;
    proposer_index: uint64;
    transaction_count: uint64;
    time_stamp_s: uint64;
    time_stamp_ms: uint64;
    transactions_merkle_root : Hash;
    parent_hash : Hash;
    extra_data: [uint8:32];
}




// Flattened BlockFragment to remove unnecessary nesting
table BlockFragment {
    index: uint64;
    tx_truncated_hashes: [TruncatedHash] (required);  // Already an inline array
    left_proof: [Hash] (required);
    right_proof: [Hash] (required);
}

// DecryptionShare is a struct since it has a fixed format
table DecryptionShare {
    transaction_index: uint64;
    data: [ubyte] (required);
}

// ErrorResponse remains a table due to variable-length string
table ErrorResponse {
    status: uint;
    substatus: uint;
    message: string (required);
}

