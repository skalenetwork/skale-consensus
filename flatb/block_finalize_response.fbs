
include "block_finalize_common_structures.fbs";

namespace block_finalize;


// Flattened SuccessResponse
table BlockFinalizeResponse {
    block_header: BlockHeader (required);
    block_sig: [uint8] (required);
    da_proof_sig: [uint8];
    block_fragment: BlockFragment; // Directly included
    decryption_shares: [DecryptionShare];
}

root_type BlockFinalizeResponse;
