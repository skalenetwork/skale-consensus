namespace skale_fb;

table Transaction {
    data: [uint8];  // Each transaction is a byte array
}

// Hashes should be structs for efficient memory layout
struct Hash {
    data: [uint8:32];
}

// Hashes should be structs for efficient memory layout
struct ExtraData {
    data: [uint8:32];
}

struct TruncatedHash {
    data: [uint8:8];
}

table BlockHeader {
    schain_id: uint64;
    epoch_id: uint64;
    block_id: uint64;
    proposer_index: uint64;
    transaction_count: uint64;
    time_stamp_s: uint64;
    time_stamp_ms: uint64;
    transactions_merkle_root : Hash;
    parent_hash : Hash ;
    extra_data: ExtraData  ;
    committee_hash: [Hash];
    public_key_hash: [Hash];
    encrypted_transaction_indices: [uint16];
}




// Flattened BlockFragment to remove unnecessary nesting
table BlockFragment {
    index: uint16;
    tx_truncated_hashes: [TruncatedHash];  // Already an inline array
    left_proof: [Hash];
    right_proof: [Hash];
}

// DecryptionShare is a struct since it has a fixed format
table DecryptionShare {
    transaction_index: uint16;
    data: [uint8] ;
}

// DecryptionShare is a struct since it has a fixed format
struct AesKey {
    transaction_index: uint16;
    data: [uint8:32];
}
